# Server
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=animales_extincion_db
# Set to true to print SQL queries in the console
DB_LOGGING=false

# Auth (JWT). Generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# First admin, created by `npm run seed` if the email does not exist yet
ADMIN_NAME=Administrador FaunBol
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (free plan) — Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=faunbol
